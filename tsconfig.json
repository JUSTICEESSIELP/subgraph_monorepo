{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
   
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "types": ["node"],
    "paths": {
      "@revert/*": ["packages/*/src"]
    }
  },
  "exclude": ["node_modules"]
}


